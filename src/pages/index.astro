---
const skills = [
  "Python",
  "SQL",
  "Machine Learning",
  "Deep Learning",
  "PyTorch",
  "Generative AI",
  "LLMs",
  "RAG",
  "LangChain",
  "LangGraph",
  "Agentic AI",
];

const projects = [
  {
    name: "V-Meet",
    description:
      "AI-powered video meeting platform with real-time communication, transcription, summarization, and intelligent meeting assistance.",
    tags: ["AI", "WebRTC", "FastAPI", "React"],
  },
  {
    name: "EchoConnect",
    description:
      "Inclusive two-way communication system connecting speech and sign-language users through AI-powered translation and communication assistance.",
    tags: ["AI", "Speech", "Sign Language", "FastAPI"],
  },
  {
    name: "Smart Meeting Locker",
    description:
      "Personal meeting library for storing recordings, multilingual transcripts, summaries, and searchable meeting information.",
    tags: ["AI", "STT", "Summarization", "SQL"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Nithish Ch - AI Engineer Portfolio" />
    <title>Nithish Ch | AI Engineer</title>
  </head>

  <body>
    <header class="navbar">
      <a href="/" class="logo">Nithish Ch</a>

      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <p class="eyebrow">AI ENGINEER · BUILDER · LEARNER</p>

        <h1>
          Building intelligent systems<br />
          that solve real problems.
        </h1>

        <p class="hero-description">
          I'm Nithish Ch, an aspiring AI Engineer focused on Machine Learning,
          Deep Learning, Generative AI, and Agentic AI.
        </p>

        <div class="hero-buttons">
          <a href="#projects" class="button primary">View Projects</a>
          <a href="/blog" class="button secondary">Read My Blog</a>
        </div>
      </section>

      <!-- ABOUT -->
      <section id="about" class="section">
        <p class="section-label">01 — ABOUT</p>

        <h2>Learning by building.</h2>

        <p class="section-text">
          I'm building my foundation from Machine Learning and Deep Learning
          toward Generative AI and Agentic AI. I document what I learn,
          experiment with technologies, and turn ideas into working systems.
        </p>
      </section>

      <!-- PROJECTS -->
      <section id="projects" class="section">
        <p class="section-label">02 — PROJECTS</p>

        <h2>Things I'm building.</h2>

        <div class="projects">
          {
            projects.map((project) => (
              <article class="project-card">
                <h3>{project.name}</h3>

                <p>{project.description}</p>

                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- SKILLS -->
      <section id="skills" class="section">
        <p class="section-label">03 — SKILLS</p>

        <h2>My technical toolkit.</h2>

        <div class="skills">
          {
            skills.map((skill) => (
              <span class="skill">{skill}</span>
            ))
          }
        </div>
      </section>

      <!-- BLOG -->
      <section class="section blog-section">
        <p class="section-label">04 — LEARNING JOURNEY</p>

        <h2>What I'm learning.</h2>

        <p class="section-text">
          I document my progress through practical problems, technical
          concepts, experiments, and projects.
        </p>

        <a href="/blog" class="text-link">Explore the blog →</a>
      </section>
    </main>

    <footer>
      <p>© 2026 Nithish Ch</p>

      <div>
        <a href="https://github.com/nithishnaidu918">GitHub</a>
        <a href="https://www.linkedin.com/">LinkedIn</a>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background: #0b0b0f;
    color: #f5f5f5;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .navbar {
    max-width: 1100px;
    margin: auto;
    padding: 28px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 20px;
    font-weight: 700;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #aaa;
    font-size: 14px;
  }

  nav a:hover {
    color: white;
  }

  main {
    max-width: 1100px;
    margin: auto;
    padding: 0 24px;
  }

  .hero {
    min-height: 78vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 900px;
  }

  .eyebrow,
  .section-label {
    font-size: 12px;
    letter-spacing: 0.18em;
    color: #888;
    font-weight: 600;
  }

  h1 {
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.05em;
    margin: 18px 0 28px;
  }

  h2 {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 12px 0 24px;
  }

  h3 {
    font-size: 24px;
    margin-top: 0;
  }

  .hero-description,
  .section-text {
    color: #aaa;
    max-width: 680px;
    font-size: 18px;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .button {
    padding: 12px 20px;
    border-radius: 8px;
    border: 1px solid #333;
    font-weight: 600;
    font-size: 14px;
  }

  .primary {
    background: white;
    color: black;
  }

  .secondary {
    background: transparent;
  }

  .section {
    padding: 100px 0;
    border-top: 1px solid #222;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 45px;
  }

  .project-card {
    border: 1px solid #25252b;
    border-radius: 14px;
    padding: 28px;
    min-height: 260px;
  }

  .project-card p {
    color: #999;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tags span,
  .skill {
    border: 1px solid #2d2d33;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 12px;
    color: #aaa;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 35px;
  }

  .skill {
    font-size: 14px;
    padding: 10px 15px;
  }

  .text-link {
    display: inline-block;
    margin-top: 25px;
    font-weight: 600;
  }

  footer {
    max-width: 1100px;
    margin: auto;
    padding: 35px 24px;
    border-top: 1px solid #222;
    display: flex;
    justify-content: space-between;
    color: #777;
    font-size: 14px;
  }

  footer div {
    display: flex;
    gap: 20px;
  }

  @media (max-width: 800px) {
    nav {
      display: none;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 70vh;
    }

    footer {
      flex-direction: column;
      gap: 15px;
    }
  }
</style>