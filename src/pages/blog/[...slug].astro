---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{post.data.title} | Nithish</title>
    <meta name="description" content={post.data.description} />
  </head>

  <body>
    <main>
      <a href="/blog/">&larr; Back to Blog</a>

      <article>
        <p>{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <p>{post.data.date.toLocaleDateString()}</p>
        <hr />

        <div class="content">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #0a0a0a;
    color: #f5f5f5;
    font-family: system-ui, sans-serif;
  }

  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  a {
    color: #aaa;
    text-decoration: none;
  }

  article {
    margin-top: 50px;
  }

  h1 {
    font-size: 42px;
    line-height: 1.1;
  }

  article > p {
    color: #aaa;
  }

  hr {
    border: 0;
    border-top: 1px solid #333;
    margin: 40px 0;
  }

  .content {
    font-size: 18px;
    line-height: 1.7;
  }

  .content :global(pre) {
    padding: 20px;
    border-radius: 10px;
    overflow-x: auto;
    background: #111;
  }

  .content :global(code) {
    font-family: monospace;
  }
</style>